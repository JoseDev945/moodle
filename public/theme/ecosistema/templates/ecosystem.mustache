{{!
    @template theme_ecosistema/ecosystem

    Hero banner and ecosystem service tiles shown on the site home and dashboard.

    Context variables required for this template:
    * greeting - Hero heading
    * subtitle - Hero subtitle
    * tiles - List of tiles with key, icon, title, description, url, external

    Example context (json):
    {
        "greeting": "¡Hola, Ana!",
        "subtitle": "Tu ecosistema educativo digital",
        "tiles": [
            {"key": "aula", "icon": "fa-chalkboard-user", "title": "Aula virtual",
             "description": "Tus cursos", "url": "#", "external": false}
        ]
    }
}}
<section class="eco-ecosystem d-print-none" aria-labelledby="eco-hero-title">
    <div class="eco-hero">
        <div class="eco-hero-text">
            <h2 id="eco-hero-title" class="eco-hero-title">{{greeting}}</h2>
            <p class="eco-hero-subtitle">{{subtitle}}</p>
        </div>
        <div class="eco-hero-badge" aria-hidden="true">
            <i class="fa-solid fa-school"></i>
        </div>
    </div>
    <ul class="eco-tiles list-unstyled">
        {{#tiles}}
        <li class="eco-tile eco-tile-{{key}}">
            <a href="{{url}}" class="eco-tile-link"{{#external}} target="_blank" rel="noopener noreferrer"{{/external}}>
                <span class="eco-tile-icon" aria-hidden="true"><i class="fa-solid {{icon}}"></i></span>
                <span class="eco-tile-body">
                    <span class="eco-tile-title">{{title}}</span>
                    <span class="eco-tile-desc">{{description}}</span>
                </span>
                {{#external}}<span class="visually-hidden">{{#str}}opensinnewwindow, core{{/str}}</span>{{/external}}
            </a>
        </li>
        {{/tiles}}
    </ul>
</section>
